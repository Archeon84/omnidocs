<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/btn_widget_new_note"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="✏️ Note"
        android:textColor="#E6E1E5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_widget_voice"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="🎙️ Voice"
        android:textColor="#E6E1E5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_widget_ocr"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="📷 Scan"
        android:textColor="#E6E1E5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_widget_ask"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="✨ Ask AI"
        android:textColor="#D0BCFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_widget_study"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="🎓 Study"
        android:textColor="#E6E1E5"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
